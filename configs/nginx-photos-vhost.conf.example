# Immich vhost for nginx on the public VPS.
# Written per Immich's official reverse-proxy docs:
# https://docs.immich.app/administration/reverse-proxy
#
# Place at /etc/nginx/sites-available/photos.<your-domain>
# and symlink into /etc/nginx/sites-enabled/ before requesting certs.
#
# Key points (this is what escaped the Cloudflare 100MB cap):
#   client_max_body_size 50000M      — no meaningful body cap
#   proxy_request_buffering off      — stream uploads, don't buffer to disk

server {
    server_name photos.<your-domain>;

    # Upload size: effectively unlimited (the whole reason this exists)
    client_max_body_size 50000M;
    client_body_buffer_size 1024k;

    # Streaming + timeouts sized for long phone uploads
    proxy_request_buffering off;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    # Standard reverse proxy headers Immich expects
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # WebSocket upgrade (web UI uses live events)
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    # Let's Encrypt ACME challenge — must exist BEFORE certbot runs, or
    # another catch-all vhost on the same box will 403 the challenge.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        # Immich VM's WireGuard tunnel address (server listens on :2283)
        proxy_pass http://10.66.71.2:2283;
    }
}

# 80: certbot manages the HTTP→HTTPS redirect after issuance. Before
# issuance, keep this block serving /.well-known (comment out the return 404).
server {
    if ($host = photos.<your-domain>) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    listen [::]:80;
    server_name photos.<your-domain>;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # After certs are issued, remove the comment on the next line:
    # return 404;
}